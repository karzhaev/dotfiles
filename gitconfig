[user]
	email = karzhaev@uav-siberia.com
	name = karzhaev
[alias]
	supd = submodule update --init --recursive
	supdf = submodule update --init --recursive --force
	lall = log --graph --all
	di = diff --ignore-all-space --ignore-blank-lines
	diw = diff --ignore-all-space --ignore-blank-lines --word-diff
	clead = clean -dff
	sclean = submodule foreach --recursive git clean -dff
	sreset = submodule foreach --recursive "git clean -dff" 
	scheckout = submodule foreach --recursive "git checkout -- ."
	vdi = difftool --tool=vimdiff --no-prompt
[core]
	editor = vim
	abbrev = 8
	pager = less -x1,5
[push]
	default = simple
[pull]
	ff = only
[diff]
	submodule = log
[log]
	date = iso
